{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ClientSettings": {
    "BaseUrl": "https://samer-kubernetes.infra-x.cloud/"
  },
  "DetailedErrors": true,
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "EcomDatabase": "YOUR_CONNECTION_STRING_HERE",
    "redis": "localhost"
  },
  "EmailSetting": {
    "Port": 587,
    "From": "YOUR_EMAIL_HERE",
    "Username": "YOUR_EMAIL_HERE",
    "Password": "YOUR_APP_PASSWORD_HERE",
    "Smtp": "smtp.gmail.com"
  },
  "Jwt": {
    "Secret": "YOUR_JWT_SECRET_KEY_HERE",
    "RefreshTokenSecret": "YOUR_REFRESH_TOKEN_SECRET_HERE",
    "Issuer": "doseHieu"
  },
  "StripSetting": {
    "publishKey": "YOUR_STRIPE_PUBLISHABLE_KEY_HERE",
    "secretKey": "YOUR_STRIPE_SECRET_KEY_HERE"
  }
}