@page "/login"
@using Microsoft.AspNetCore.Authorization
@layout EmptyLayout
@attribute [AllowAnonymous]

<MudContainer Style="padding-top:inherit;" MaxWidth="MaxWidth.Large">



    <MudGrid>
        <MudItem xs="12" sm="12">
            <MudPaper Class="pa-4 mud-theme-primary">
                <MudText Align="Align.Center" Typo="Typo.h4">Login</MudText>
            </MudPaper>
        </MudItem>
    </MudGrid>






    <EditForm Model="@loginVM" OnValidSubmit="HandleLogin">
        <DataAnnotationsValidator />
        <MudGrid>
            <MudItem xs="12" sm="7">
                <MudCard>
                    <MudCardContent>
                        <MudTextField Label="Email"
                                      @bind-Value="loginVM.Email" For="@(() => loginVM.Email)" />

                        <MudTextField Label="Password" Class="mt-3"
                                      @bind-Value="loginVM.Password" For="@(() => loginVM.Password)"
                                      InputType="@PasswordInput" Adornment="Adornment.End" AdornmentIcon="@PasswordInputIcon" OnAdornmentClick="ButtonTestclick" />

                    </MudCardContent>



                    <MudCardActions>
                        <MudItem xs="12" Class="d-flex flex-column gap-4 w-100">
                            <MudItem Class="d-flex align-center justify-center gap-4">
                                <MudButton ButtonType="ButtonType.Submit" Disabled="@isVisiblebtn"  Variant="Variant.Filled"  Color="Color.Primary"  Style="border-radius: 20px; padding: 8px 30px;">
                                    @if (isVisiblebtn)
                                    {
                                        <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                                        <MudText Class="ms-2">Processing ...</MudText>
                                    }
                                    else
                                    {
                                        <MudText>Login</MudText>
                                    }
                                </MudButton>

                                <MudButton Href="/forgotpasswordbyemail" Color="Color.Primary" DisableElevation="true">
                                    Forgot password?
                                </MudButton>
                            </MudItem>

                            <MudCard Outlined="true" Elevation="0">
                                <div class="d-flex align-center justify-space-between pa-4">
                                    <MudText>Don't have an account yet?</MudText>
                                    <MudButton Href="/register" Variant="Variant.Outlined" DisableElevation="true" Color="Color.Primary" Style="border-radius: 20px; padding: 8px 30px;">
                                        Sign up
                                    </MudButton>
                                </div>
                            </MudCard>
                        </MudItem>
                    </MudCardActions>

                </MudCard>
            </MudItem>
            <MudItem xs="12" sm="5">
                <MudPaper Class="pa-4 mud-height-full">
                    <MudText Typo="Typo.subtitle2">Validation Summary</MudText>
                    @if (ShowMessage)
                    {
                        <MudAlert Severity="Severity.Warning">@Message</MudAlert>
                    }
                    else
                    {
                        <MudText Color="@Color.Error">
                            <ValidationSummary />
                        </MudText>
                    }
                </MudPaper>
            </MudItem>
        </MudGrid>
    </EditForm>


    @*ExternalLogin=============================================================*@
    <MudGrid>
        <MudItem xs="12" sm="7">

            <MudCardActions>
                <MudGrid>
                    <MudItem xs="12" sm="6">
                        @{
                            // string pathfacebook = $"{CMSConstant.BaseApiAddress}api/Account/facebook-login?returnurl={CMSConstant.BaseApiAddressClient}";
                        }
                        @* <MudButton Style="background-color: rgb(66 103 178);color:white;" *@
                        @*            Class="d-flex align-center justify-center mud-width-full " *@
                        @*            Variant="Variant.Filled" Href="@pathfacebook"> *@
                        @*     FaceBook *@
                        @* </MudButton> *@
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        @{
                            // string pathgoogle = $"{CMSConstant.BaseApiAddress}api/Account/google-login?returnurl={CMSConstant.BaseApiAddressClient}";
                        }
                        @* <MudButton Style="background-color: rgb(219 68 55); color: white;" *@
                        @*            Class="d-flex align-center justify-center mud-width-full " *@
                        @*            Variant="Variant.Filled" Href="@pathgoogle"> *@
                        @*     Google *@
                        @* </MudButton> *@
                    </MudItem>
                </MudGrid>
            </MudCardActions>
            @*==========================================================================*@
        </MudItem>
    </MudGrid>
</MudContainer>


