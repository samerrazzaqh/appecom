@page "/forgotpasswordbyemail"
@layout EmptyLayout


<MudContainer Style="padding-top:inherit;" MaxWidth="MaxWidth.Large">
    <MudGrid>
        <MudItem xs="12" sm="12">
            <MudPaper Class="pa-4 mud-theme-primary">
                <MudText Align="Align.Center" Typo="Typo.h4">Forgot Password</MudText>
            </MudPaper>
        </MudItem>
    </MudGrid>


    <EditForm Model="this" OnValidSubmit="HandleForgotPasswordbyEmail">
        <DataAnnotationsValidator />
        <MudGrid>
            <MudItem xs="12" sm="7">
                <MudCard>
                    <MudCardContent>

                        <MudTextField Label="Email" Required
                                      @bind-Value="email" For="@(() => email)" />

                    </MudCardContent>
                    <MudCardActions>
                        <MudButton ButtonType="ButtonType.Submit" Disabled="@isVisiblebtn"  Variant="Variant.Filled"  Color="Color.Primary"  Style="border-radius: 20px; padding: 8px 30px;">
                            @if (isVisiblebtn)
                            {
                                <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                                <MudText Class="ms-2">Processing ...</MudText>
                            }
                            else
                            {
                                <MudText>Submit</MudText>
                            }
                        </MudButton>
                    </MudCardActions>
                </MudCard>
            </MudItem>
            <MudItem xs="12" sm="5">
                <MudPaper Class="pa-4 mud-height-full">
                    <MudText Typo="Typo.subtitle2">Validation Summary</MudText>
                    @if (ShowMessage)
                    {
                        <MudAlert Severity="Severity.Error">@Message</MudAlert>
                    }
                    else
                    {
                        <MudText Color="@Color.Error">
                            <ValidationSummary />
                        </MudText>
                    }
                </MudPaper>
            </MudItem>
        </MudGrid>
    </EditForm>
</MudContainer>