<div class="product-card-wrapper h-100">
    <MudCard Elevation="1" Class="product-card rounded-lg relative overflow-hidden d-flex flex-column h-100">
        <!-- الصورة الرئيسية -->
        <div class="product-img-container pa-2">
            <MudCardMedia Image="@SelectedImage" Height="180" Style="background-size: contain; background-position: center; border-radius: 6px;" />
        </div>

        <!-- الصور المصغرة -->
        @if (Images != null && Images.Any())
        {
            <MudStack Row="true" Spacing="1" Class="px-3 pt-1" Justify="Justify.FlexStart">
                @foreach (var img in Images)
                {
                    <img src="@img" 
                         class="thumb-img @(SelectedImage == img ? "active-thumb" : "")" 
                         @onclick="() => SelectImage(img)" />
                }
            </MudStack>
        }

        <!-- تفاصيل المنتج مع تثبيت الارتفاع -->
        <MudCardContent Class="pt-3 pb-2 flex-grow-1 d-flex flex-column justify-between">
            <div>
                <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Start">
                    <MudText Typo="Typo.h6" Class="bold text-truncate">@Title</MudText>
                    <MudIconButton Icon="@(IsBookmarked ? Icons.Material.Filled.Bookmark : Icons.Material.Outlined.BookmarkBorder)" 
                                   Color="Color.Primary" 
                                   Size="Size.Small" 
                                   Class="pa-0" 
                                   OnClick="OnBookmarkClick" />
                </MudStack>

                <!-- عرض النجوم والتقييم -->
                <div class="d-flex align-center gap-1 my-1">
                    <MudRating SelectedValue="@((int)Math.Round(Rating))" ReadOnly="true" Size="Size.Small" Color="Color.Warning" />
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">
                        (@Rating.ToString("0.0"))
                    </MudText>
                </div>

                <!-- تحديد أقصى ارتفاع للوصف مع إخفاء الزائد -->
                <p class="description-text mud-text-secondary my-2">
                    @Description
                </p>
            </div>

            <!-- الأسعار -->
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mt-auto pt-2">
                @if (OldPrice.HasValue)
                {
                    <MudText Typo="Typo.body2" Class="text-decoration-line-through mud-text-secondary">$@OldPrice.Value.ToString("N2")</MudText>
                }
                <MudText Typo="Typo.body1" Class="bold color-primary">$@Price.ToString("N2")</MudText>
            </MudStack>
        </MudCardContent>

        <!-- الأزرار مثبتة بالأسفل دائماً -->
        <MudCardActions Class="pa-3 pt-0">
            <MudGrid Spacing="1">
                <MudItem xs="6">
                    <MudButton FullWidth="true" 
                               Variant="Variant.Filled" 
                               StartIcon="@Icons.Material.Filled.AddShoppingCart" 
                               Color="Color.Dark" 
                               Style="text-transform: none; font-size: 0.75rem;" 
                               Class="py-2"
                               OnClick="OnAddToCart">
                        Add To Cart
                    </MudButton>
                </MudItem>
                <MudItem xs="6">
                    <MudButton FullWidth="true" 
                               Variant="Variant.Filled" 
                               StartIcon="@Icons.Material.Filled.Info" 
                               Color="Color.Success" 
                               Style="text-transform: none; font-size: 0.75rem;" 
                               Class="py-2"
                               OnClick="OnDetails">
                        Details
                    </MudButton>
                </MudItem>
            </MudGrid>
        </MudCardActions>

    </MudCard>
</div>